ADMIN_PASSWORD=

# --- Lead e-mail notifications ---
# Set ONE provider key. Without a key the app still works; it just logs a warning.
RESEND_API_KEY=
# SENDGRID_API_KEY=
# Comma separated recipients (default: danycleanenpro@gmail.com)
LEAD_NOTIFY_TO=
# Verified sender, e.g. "Dany Clean Pro <requests@danycleanpro.com>"
LEAD_NOTIFY_FROM=
