# Gemini API Key (Backend only)
GEMINI_API_KEY=

# Firebase Admin SDK (Backend only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Only if the project uses a NAMED Firestore database — must match
# VITE_FIREBASE_DATABASE_ID, or server writes hit a database that isn't there.
FIRESTORE_DATABASE_ID=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Auth Secret (for server-side if needed)
JWT_SECRET=
ADMIN_PASSWORD=

# --- Lead e-mail notifications ---
# Pick ONE option. Without any of them the app still works; it just logs a warning.
#
# Option A (no third-party service): send from the business Gmail itself.
# Requires 2-Step Verification on the account + an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option B: a transactional provider (better deliverability at volume)
# RESEND_API_KEY=
# SENDGRID_API_KEY=
#
# Option C: any other mail server
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Comma separated recipients (default: danycleanenpro@gmail.com)
LEAD_NOTIFY_TO=
# Verified sender, e.g. "Dany Clean Pro <requests@danycleanpro.com>"
LEAD_NOTIFY_FROM=

# --- Automated follow-ups (hourly scheduled function) ---
# Off unless this is exactly "true". Set AUTOMATION_DRY_RUN=true first to see
# what WOULD be sent in the function logs without sending anything.
AUTOMATION_ENABLED=false
AUTOMATION_DRY_RUN=true
# Timing, in hours (defaults shown)
# AUTOMATION_NUDGE_HOURS=2            # nudge the owner about an untouched lead
# AUTOMATION_FOLLOWUP_HOURS=72        # chase a quiet lead after first contact
# AUTOMATION_REVIEW_HOURS=24          # ask for a review after the visit
# AUTOMATION_REVIEW_WINDOW_HOURS=168  # ...but not past a week
# AUTOMATION_WINBACK_HOURS=1080       # win-back after 45 days
# AUTOMATION_MAX_PER_RUN=25           # ceiling per rule, per hour
