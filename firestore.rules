rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'wagnergoisoficial@gmail.com' ||
        request.auth.token.email.endsWith('@danycleanpro.com') ||
        request.auth.token.email.endsWith('@admin.com')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    // 2. Collection Specific Rules

    // Settings: Publicly readable, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(incoming());

      function isValidSettings(data) {
        return data.keys().hasAll(['value']) &&
               data.keys().size() == 1 &&
               (data.value == null || (data.value is string && data.value.size() <= 1048576));
      }
    }

    // Reviews: Publicly readable if published, Anyone can create (feedback), Admin update/delete
    match /reviews/{reviewId} {
      allow list: if (resource.data.isPublished == true || isAdmin());
      allow get: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update, delete: if isAdmin();

      function isValidReview(data) {
        return data.keys().hasAll(['author', 'rating', 'comment', 'date', 'isPublished']) &&
               data.author is string && data.author.size() <= 100 &&
               data.rating is number && data.rating >= 1 && data.rating <= 5 &&
               data.comment is string && data.comment.size() <= 1000 &&
               data.isPublished == false;
      }
    }

    // Gallery: Publicly readable, Admin write
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidGallery(incoming());

      function isValidGallery(data) {
        return data.keys().hasAll(['url', 'title', 'category', 'createdAt']) &&
               data.url is string && data.url.size() <= 1000 &&
               data.title is string && data.title.size() <= 200 &&
               data.category is string && data.category.size() <= 100 &&
               data.createdAt == request.time;
      }
    }

    // Leads: Anyone can create with required core fields. Admin read/update/delete.
    // CHANGED for Phase 0:
    //   - Removed exact keys().size() match (was rejecting valid writes with optional fields)
    //   - Removed bedrooms/bathrooms/zip_code from required (they're optional)
    //   - Added non-empty checks on name/email/phone
    match /leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read, update, delete: if isAdmin();

      function isValidLead(data) {
        return data.keys().hasAll(['name', 'email', 'phone', 'city', 'service_type', 'status', 'createdAt']) &&
               data.keys().size() <= 15 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
               data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
               data.city is string && data.city.size() <= 100 &&
               data.service_type is string && data.service_type.size() <= 100 &&
               data.status == 'new' &&
               data.createdAt == request.time;
      }
    }

    // Admins: Read-only for self (to check status), write-only for existing admins
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Customers: Admin only. No delete allowed.
    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidCustomer(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidCustomer(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;

      function isValidCustomer(data) {
        return data.keys().hasAll(['name', 'phone', 'status', 'createdAt', 'updatedAt']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
               (data.status == 'active' || data.status == 'inactive') &&
               (data.email == null || data.email is string) &&
               (data.leadId == null || data.leadId is string);
      }

      // Customer Timeline: Admin only. Read and Create only (Append-only).
      match /timeline/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && isValidTimelineEvent(incoming(), customerId);
        allow update, delete: if false;

        function isValidTimelineEvent(data, pathCustomerId) {
          return data.keys().hasAll(['type', 'title', 'description', 'customerId', 'createdAt']) &&
                 data.type in ['customer_created', 'customer_updated', 'notes_updated', 'status_changed', 'converted_from_lead', 'system'] &&
                 data.title is string && data.title.size() <= 200 &&
                 data.description is string && data.description.size() <= 2000 &&
                 data.customerId == pathCustomerId &&
                 data.createdAt == request.time;
        }
      }
    }
  }
}
